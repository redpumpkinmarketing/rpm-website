---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import ArchMedia from '../components/ArchMedia.astro';
---
<ArticleLayout title="Article title — awaiting approved copy" description="Article summary placeholder. Replace with the approved introduction before publication." category="Category awaiting approval" preview><ArchMedia caption="Article image placeholder"/><h2>Section heading placeholder</h2><p>Approved article text will appear here. No article has been published.</p><blockquote>Approved quotation or pull quote placeholder.</blockquote><h2>Next section placeholder</h2><p>Use this space for the next approved section, with supporting images or lists where helpful.</p></ArticleLayout>
