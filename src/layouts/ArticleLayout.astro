---
import Layout from './Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
interface Props { title:string;description:string;category:string;author?:string;published?:string;preview?:boolean; }
const {title,description,category,author,published,preview=false}=Astro.props;
---
<Layout title={title+' | RPM Insights'} description={description}><article class="article-template container"><header><Eyebrow text={category} numbered={false}/>{preview&&<p class="preview-note">Unpublished article template — all content below is a marked placeholder.</p>}<h1>{title}</h1><p class="article-deck">{description}</p><div class="article-byline"><span>{author??'Author awaiting approval'}</span>{published?<time datetime={published}>{published}</time>:<span>Publication date awaiting approval</span>}</div></header><div class="article-content"><slot/></div><footer><a class="text-link" href="/insights">Back to Insights ↗</a></footer></article></Layout>
<style>.article-template{max-width:1000px;padding-block:60px 100px}.article-template h1{font-size:clamp(44px,6vw,88px);line-height:1.05}.article-deck{font-size:22px;max-width:720px;margin-top:30px}.article-byline{display:flex;gap:25px;flex-wrap:wrap;padding-block:20px;border-block:1px solid var(--line);font-size:14px}.article-content{max-width:760px;margin:55px auto}.article-content :global(h2){margin:45px 0 20px}.article-content :global(p){font-size:18px}.article-template footer{margin-top:50px}</style>
