---
import Eyebrow from './Eyebrow.astro';

import { services, contactEmail, contactCity, emailHref, whatsappHref, whatsappNumber } from '../data/site';
const countryCodes='AF AL DZ AD AO AG AR AM AU AT AZ BS BH BD BB BY BE BZ BJ BT BO BA BW BR BN BG BF BI CV KH CM CA CF TD CL CN CO KM CG CD CR CI HR CU CY CZ DK DJ DM DO EC EG SV GQ ER EE SZ ET FJ FI FR GA GM GE DE GH GR GD GT GN GW GY HT HN HU IS IN ID IR IQ IE IL IT JM JP JO KZ KE KI KP KR KW KG LA LV LB LS LR LY LI LT LU MG MW MY MV ML MT MH MR MU MX FM MD MC MN ME MA MZ MM NA NR NP NL NZ NI NE NG MK NO OM PK PW PS PA PG PY PE PH PL PT QA RO RU RW KN LC VC WS SM ST SA SN RS SC SL SG SK SI SB SO ZA SS ES LK SD SR SE CH SY TW TJ TZ TH TL TG TO TT TN TR TM TV UG UA AE GB US UY UZ VU VA VE VN YE ZM ZW'.split(' ');
const display=new Intl.DisplayNames(['en'],{type:'region'});
const countries=countryCodes.map(c=>display.of(c)!).sort();
---
<section class="section contact-stage" id="enquiry"><div class="container contact-split">
<div class="contact-intro"><Eyebrow text="Let's talk"/><h1>Good things start with a conversation.</h1><p>You don't need all the answers. Tell us what you know about the project and the outcome you're hoping for.</p><dl class="contact-details"><div><dt>Email</dt><dd><a href={emailHref}>{contactEmail || 'Email address to be added'} <span aria-hidden="true">↗</span></a></dd></div><div><dt>WhatsApp</dt><dd><a href={whatsappHref}>{/^\d{7,15}$/.test(whatsappNumber)?'+'+whatsappNumber:'WhatsApp number to be added'} <span aria-hidden="true">↗</span></a></dd></div><div><dt>Find us</dt><dd>{contactCity || 'City to be confirmed'}, India</dd></div></dl><p id="whatsapp-setup-note" class="channel-note" hidden></p></div>
<div class="enquiry-panel"><form id="project-form" novalidate aria-label="Project enquiry"><div class="form-progress"><p id="step-status" aria-live="polite">Step 1 of 3 · What do you need?</p><progress id="enquiry-progress" max="3" value="1" aria-label="Enquiry progress">1 of 3</progress><ol aria-label="Enquiry steps"><li aria-current="step">Your needs</li><li>Your business</li><li>Your details</li></ol></div>
{import.meta.env.DEV && <p class="development-notice">Preview only: use sample details while reviewing this development site.</p>}
<p id="form-connection" class="connection-note">Online enquiries are not connected yet. Sending is currently unavailable.</p>
<noscript><p>Please enable JavaScript to use this three-step form. No information has been sent.</p></noscript>
<fieldset data-form-step="0"><legend tabindex="-1">What do you need?</legend><p>Choose a starting point. We can work out the details together.</p><label class="form-field">What would you like to discuss? *<select name="type"><option value="new-project">A new project</option><option value="existing-project">An existing project</option><option value="collaboration">A professional collaboration</option><option value="general">A general enquiry</option></select></label>
<fieldset id="service-options" aria-describedby="service-help service-error"><legend>What can we help you with? <span id="service-required">*</span></legend><p id="service-help">Choose one or more areas, or let us help you decide.</p><div class="check-options">{services.map(s=><label><input type="checkbox" name="service" value={s.slug}/>{s.name}</label>)}<label><input type="checkbox" name="service" value="help-me-decide"/>Help me decide</label></div><p id="service-error" class="field-error" role="alert"></p></fieldset></fieldset>
<fieldset data-form-step="1" hidden><legend tabindex="-1">About your business</legend><p>A little context helps us ask better questions.</p><label class="form-field">Company / organisation (optional)<input name="company" autocomplete="organization" placeholder="Your business or organisation"/></label><label class="form-field">Website or social profile (optional)<input name="website" type="url" placeholder="https://yourwebsite.com"/></label><label class="form-field">Tell us about your project *<textarea name="details" required minlength="20" placeholder="What would you like to build, improve or achieve?"/></label><div class="form-grid"><label class="form-field">Budget (optional)<input name="budget" placeholder="Range and currency, if known"/></label><label class="form-field">When would you like to begin? (optional)<select name="timeline"><option value="">Select a timeline</option>{['As soon as practical','Within the next 1–3 months','In 3–6 months','Timing is flexible','Still exploring'].map(o=><option>{o}</option>)}</select></label></div></fieldset>
<fieldset data-form-step="2" hidden><legend tabindex="-1">Your contact details</legend><p>Where can we continue the conversation? Fields marked * are required.</p><label class="form-field">Your name *<input name="name" autocomplete="name" required placeholder="What should we call you?"/></label><label class="form-field">Your email address *<input name="email" type="email" autocomplete="email" required placeholder="you@company.com"/></label><label class="form-field">Your country *<input name="country" list="countries" autocomplete="country-name" required placeholder="Select your country"/><datalist id="countries">{countries.map(c=><option value={c}/>)}</datalist></label><label class="form-field">How would you prefer us to contact you?<select name="method"><option>Email</option><option>Phone call</option><option>WhatsApp</option></select></label><label class="form-field" id="phone-field" hidden>Phone / WhatsApp number *<input name="phone" type="tel" autocomplete="tel" placeholder="Country code + phone number" disabled/></label><p class="enquiry-purpose">These details help us respond to your enquiry.</p></fieldset>
<div class="form-controls"><button class="text-link" type="button" id="form-back" hidden>← Back</button><button class="button" type="button" id="form-next" disabled>Continue ↗</button><button class="button" type="submit" id="form-send" disabled hidden aria-describedby="form-connection">Send your enquiry ↗</button></div><p id="form-status" class="form-status" role="status" tabindex="-1"></p></form>
<div id="form-thanks" class="form-thanks" hidden tabindex="-1"><span class="thanks-arch" aria-hidden="true">✓</span><h2>Thank you.<br/>Let's make it count.</h2><p>Your enquiry has been received. We look forward to continuing the conversation.</p><a class="text-link" href="/work">Explore our work ↗</a></div></div></div></section>
<script>import '../scripts/contact-form';</script>
